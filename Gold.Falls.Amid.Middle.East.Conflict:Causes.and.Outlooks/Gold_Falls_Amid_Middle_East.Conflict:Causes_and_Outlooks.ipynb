# Install packages if needed
# !pip install yfinance pandas matplotlib

import yfinance as yf
import pandas as pd
import matplotlib.pyplot as plt

# Download gold price data (Gold Futures)
gold = yf.download("GC=F", start="2023-01-01", end="2026-01-01")

# Keep closing price
gold = gold[['Close']]
gold.rename(columns={'Close':'price'}, inplace=True)

# Calculate EMAs
gold['EMA 50'] = gold['price'].ewm(span=50, adjust=False).mean()
gold['EMA 100'] = gold['price'].ewm(span=100, adjust=False).mean()
gold['EMA 200'] = gold['price'].ewm(span=200, adjust=False).mean()

# Plot
plt.figure(figsize=(12,6))

# Area for gold price
plt.fill_between(gold.index, gold['price'], alpha=0.25)

# Price line
plt.plot(gold.index, gold['price'], linewidth=2)

# EMA lines
plt.plot(gold.index, gold['EMA 50'], label="EMA 50", linewidth=2)
plt.plot(gold.index, gold['EMA 100'], label="EMA 100", linewidth=2)
plt.plot(gold.index, gold['EMA 200'], label="EMA 200", linewidth=2)

# Title and styling
plt.title("Gold Price in U.S. Dollars (2023–2026)", fontsize=16)
plt.xlabel("")
plt.ylabel("USD")
plt.legend()
plt.grid(alpha=0.2)

plt.show()

