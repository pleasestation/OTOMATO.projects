import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.dates as mdates

# Включаем отображение графиков прямо в ноутбуке
%matplotlib inline

# 1. Генерируем данные (имитация тренда с картинки)
np.random.seed(42)
dates = pd.date_range(start='2023-08-01', end='2026-03-01', freq='D')
n = len(dates)
trend = np.linspace(1700, 5000, n)
noise = np.random.normal(0, 40, n).cumsum() 
prices = trend + noise

df = pd.DataFrame({'Gold Price': prices}, index=dates)

# 2. Считаем скользящие средние (EMA)
df['EMA 50'] = df['Gold Price'].ewm(span=50, adjust=False).mean()
df['EMA 100'] = df['Gold Price'].ewm(span=100, adjust=False).mean()
df['EMA 200'] = df['Gold Price'].ewm(span=200, adjust=False).mean()

# 3. Настройка стиля и отрисовка
plt.figure(figsize=(14, 7), facecolor='white')
ax = plt.gca()

# Основная область цен
ax.plot(df.index, df['Gold Price'], color='#4db6ac', alpha=0.7, label='Gold Price Quotes')
ax.fill_between(df.index, df['Gold Price'], 1000, color='#4db6ac', alpha=0.1)

# Линии EMA (цвета как на оригинале)
ax.plot(df.index, df['EMA 50'], color='#1a237e', linewidth=1.5)
ax.plot(df.index, df['EMA 100'], color='#7986cb', linewidth=1.5)
ax.plot(df.index, df['EMA 200'], color='#f06292', linewidth=1.5)

# 4. Оформление текста и осей
plt.title('Gold Price in USD, 2023–2026', fontsize=18, fontweight='bold', loc='left', pad=20)
plt.ylim(1000, 6000)
plt.xlim(df.index.min(), df.index.max())

# Текстовые метки EMA справа
last_idx = df.index[-1]
ax.text(last_idx, df['EMA 50'].iloc[-1], '  EMA 50', color='#1a237e', va='center', fontweight='bold')
ax.text(last_idx, df['EMA 100'].iloc[-1], '  EMA 100', color='#7986cb', va='center', fontweight='bold')
ax.text(last_idx, df['EMA 200'].iloc[-1], '  EMA 200', color='#f06292', va='center', fontweight='bold')

# Подпись внутри графика
ax.text(pd.Timestamp('2025-05-01'), 2500, 'Gold Price Quotes', color='#4db6ac', fontsize=12, fontweight='bold')

# Форматирование дат (Янв, Май, Сент)
ax.xaxis.set_major_locator(mdates.MonthLocator(bymonth=[1, 5, 9]))
ax.xaxis.set_major_formatter(mdates.DateFormatter('%b\n%Y'))

# Убираем лишние границы
ax.spines['top'].set_visible(False)
ax.spines['right'].set_visible(False)
plt.grid(axis='y', linestyle='--', alpha=0.3)

plt.tight_layout()
plt.show() # Эта команда выведет картинку в ноутбук

