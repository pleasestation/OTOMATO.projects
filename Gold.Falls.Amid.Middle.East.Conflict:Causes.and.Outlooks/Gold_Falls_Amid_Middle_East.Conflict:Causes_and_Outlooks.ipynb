# Libraries
library(tidyverse)
library(TTR)
library(scales)

# Example: load your gold data
# Data must contain: date, price
# Replace with your dataset
gold <- read.csv("gold_prices.csv")

gold$date <- as.Date(gold$date)

# Calculate EMAs
gold <- gold %>%
  arrange(date) %>%
  mutate(
    EMA50 = EMA(price, n = 50),
    EMA100 = EMA(price, n = 100),
    EMA200 = EMA(price, n = 200)
  )

# Plot
ggplot(gold, aes(x = date)) +

  # gold price area
  geom_area(aes(y = price),
            fill = "#a7d5cf",
            alpha = 0.35) +

  geom_line(aes(y = price),
            color = "#63c1b7",
            linewidth = 1) +

  # EMA lines
  geom_line(aes(y = EMA50, color = "EMA 50"), linewidth = 1.2) +
  geom_line(aes(y = EMA100, color = "EMA 100"), linewidth = 1.2) +
  geom_line(aes(y = EMA200, color = "EMA 200"), linewidth = 1.2) +

  scale_color_manual(
    values = c(
      "EMA 50" = "#1f4e9e",
      "EMA 100" = "#6c6cd8",
      "EMA 200" = "#ff6fd8"
    )
  ) +

  scale_y_continuous(labels = dollar_format()) +

  labs(
    title = "Gold Price in U.S. Dollars (2023–2026)",
    x = NULL,
    y = NULL,
    color = NULL
  ) +

  theme_minimal(base_size = 14) +

  theme(
    plot.title = element_text(face = "bold", size = 18),
    legend.position = "right"
  )
