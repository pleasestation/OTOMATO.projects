# Gold Price Analysis Notebook

# ---------------------------
# 1. Imports
# ---------------------------
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import sqlite3

# For better plots
sns.set_style('whitegrid')
plt.rcParams['figure.figsize'] = (14,7)

# ---------------------------
# 2. Connect to SQL Database (example logic)
# ---------------------------
# Suppose we have gold prices in a SQLite DB
db_path = 'gold_prices.db'  # Replace with your database path
conn = sqlite3.connect(db_path)

# SQL query to fetch daily gold prices from 2023 to 2026
query = """
SELECT date, price_usd
FROM gold_daily
WHERE date >= '2023-01-01'
ORDER BY date ASC;
"""

gold_df = pd.read_sql(query, conn)

# ---------------------------
# 3. Data Processing
# ---------------------------
# Convert date column to datetime
gold_df['date'] = pd.to_datetime(gold_df['date'])

# Calculate moving averages
gold_df['EMA_50'] = gold_df['price_usd'].ewm(span=50, adjust=False).mean()
gold_df['EMA_100'] = gold_df['price_usd'].ewm(span=100, adjust=False).mean()
gold_df['EMA_200'] = gold_df['price_usd'].ewm(span=200, adjust=False).mean()

# Calculate RSI (14-day)
def compute_rsi(data, window=14):
    delta = data.diff()
    gain = (delta.where(delta > 0, 0)).rolling(window=window).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(window=window).mean()
    RS = gain / loss
    RSI = 100 - (100 / (1 + RS))
    return RSI

gold_df['RSI_14'] = compute_rsi(gold_df['price_usd'])

# ---------------------------
# 4. Visualization
# ---------------------------
plt.figure(figsize=(16,8))
plt.plot(gold_df['date'], gold_df['price_usd'], label='Gold Price USD', color='gold')
plt.plot(gold_df['date'], gold_df['EMA_50'], label='EMA 50', linestyle='--')
plt.plot(gold_df['date'], gold_df['EMA_100'], label='EMA 100', linestyle='--')
plt.plot(gold_df['date'], gold_df['EMA_200'], label='EMA 200', linestyle='--')
plt.title('Gold Price in USD (2023-2026)')
plt.xlabel('Date')
plt.ylabel('Price USD')
plt.legend()
plt.show()

# RSI plot
plt.figure(figsize=(16,4))
plt.plot(gold_df['date'], gold_df['RSI_14'], label='RSI 14', color='purple')
plt.axhline(30, color='red', linestyle='--', label='Oversold')
plt.axhline(70, color='green', linestyle='--', label='Overbought')
plt.title('Gold RSI (14-Day)')
plt.xlabel('Date')
plt.ylabel('RSI')
plt.legend()
plt.show()

# ---------------------------
# 5. Observations
# ---------------------------
print("Latest Gold Price:", gold_df['price_usd'].iloc[-1])
print("50-day EMA:", gold_df['EMA_50'].iloc[-1])
print("100-day EMA:", gold_df['EMA_100'].iloc[-1])
print("200-day EMA:", gold_df['EMA_200'].iloc[-1])
print("RSI:", gold_df['RSI_14'].iloc[-1])

# ---------------------------
# 6. Example SQL Logic for Aggregated Analysis
# ---------------------------
example_sql = """
-- Average monthly gold price
SELECT strftime('%Y-%m', date) as month, AVG(price_usd) as avg_price
FROM gold_daily
GROUP BY month
ORDER BY month;
"""

print("\nExample SQL for Monthly Aggregation:")
print(example_sql)
